DATABASE_URI=
PAYLOAD_SECRET=
CMS_ADMIN_PASSWORD=apex-admin

# Cloudflare R2 (CMS image & file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Optional: custom S3 API endpoint (defaults to https://<account_id>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# Live chatbot (Groq)
GROQ_API_KEY=
# Optional model override (default: qwen/qwen3.6-27b)
GROQ_MODEL=

# PostHog — visitor analytics (public site tracking + admin dashboard)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Personal API key (query:read) + project ID for /admin/analytics dashboard
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Optional error monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Google Analytics report URL (Looker Studio / GA4 share link for /admin/analytics/google)
NEXT_PUBLIC_GA_REPORT_URL=

# UptimeRobot (external monitoring — /admin/uptime)
UPTIMEROBOT_API_KEY=
NEXT_PUBLIC_UPTIMEROBOT_STATUS_PAGE_URL=
# Optional override (defaults to https://dashboard.uptimerobot.com/monitors)
NEXT_PUBLIC_UPTIMEROBOT_DASHBOARD_URL=

# Pipeline logs — optional deploy & commit streams
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
GITHUB_TOKEN=
GITHUB_REPO=

# Alerts — email (Resend), Teams webhook, SMS (Twilio)
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CRON_SECRET=
